  },
  "bugs": {
    "url": "https://github.com/henrywen98/pi-plan-mode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "plan-mode"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "NOTICE",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
